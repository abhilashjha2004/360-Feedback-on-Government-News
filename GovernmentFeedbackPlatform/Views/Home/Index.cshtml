@model GovernmentFeedbackPlatform.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home - GovFeedback360";
}

<!-- Hero Section -->
<section class="hero-section py-5 text-white" style="background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-4 fw-bold mb-3">
                    <i class="fa-solid fa-rotate me-2" style="color:#ff9933;"></i>
                    360° Feedback on Government News
                </h1>
                <p class="lead mb-4">Your voice shapes better governance. Rate, review and analyse government news stories from across India.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-action="Index" asp-controller="News" class="btn btn-warning btn-lg fw-semibold text-dark">
                        <i class="fa-solid fa-search me-2"></i>Browse Latest News
                    </a>
                    <a asp-action="Index" asp-controller="News" class="btn btn-outline-light btn-lg fw-semibold">
                        <i class="fa-solid fa-comment me-2"></i>Submit Feedback
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <i class="fa-solid fa-landmark fa-10x opacity-25 mt-3"></i>
            </div>
        </div>
    </div>
</section>

<!-- Stats Bar -->
<section class="py-4" style="background:#f4f6fa;">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="card border-0 rounded-3 h-100 text-white text-center py-3" style="background:#1e3a5f;">
                    <div class="card-body">
                        <i class="fa-solid fa-users fa-2x mb-2" style="color:#ff9933;"></i>
                        <h3 class="fw-bold mb-0">@Model.Stats.TotalUsers</h3>
                        <p class="mb-0 small opacity-75">Citizens</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 rounded-3 h-100 text-white text-center py-3" style="background:#1e3a5f;">
                    <div class="card-body">
                        <i class="fa-solid fa-newspaper fa-2x mb-2" style="color:#ff9933;"></i>
                        <h3 class="fw-bold mb-0">@Model.Stats.TotalNews</h3>
                        <p class="mb-0 small opacity-75">News Stories</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 rounded-3 h-100 text-white text-center py-3" style="background:#1e3a5f;">
                    <div class="card-body">
                        <i class="fa-solid fa-comments fa-2x mb-2" style="color:#ff9933;"></i>
                        <h3 class="fw-bold mb-0">@Model.Stats.TotalFeedbacks</h3>
                        <p class="mb-0 small opacity-75">Feedbacks</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 rounded-3 h-100 text-white text-center py-3" style="background:#1e3a5f;">
                    <div class="card-body">
                        <i class="fa-solid fa-star fa-2x mb-2" style="color:#ff9933;"></i>
                        <h3 class="fw-bold mb-0">@Model.Stats.AverageRating.ToString("F1")</h3>
                        <p class="mb-0 small opacity-75">Avg Rating</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Latest Government News -->
<section class="py-5">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="fw-bold" style="color:#1e3a5f;">
                <i class="fa-solid fa-newspaper me-2" style="color:#ff9933;"></i>Latest Government News
            </h2>
            <a asp-action="Index" asp-controller="News" class="btn btn-sm text-white" style="background:#1e3a5f;">
                View All <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="row g-4">
            @foreach (var news in Model.LatestNews.Take(6))
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                        <img src="@(string.IsNullOrEmpty(news.ImageUrl) ? $"https://picsum.photos/seed/{news.Id}/400/220" : news.ImageUrl)"
                             class="card-img-top" alt="@news.Title"
                             style="height:180px; object-fit:cover;" />
                        <div class="card-body d-flex flex-column">
                            @if (news.Category != null)
                            {
                                <span class="badge mb-2 text-white align-self-start" style="background:#1e3a5f;">
                                    @news.Category.Name
                                </span>
                            }
                            <h5 class="card-title fw-semibold" style="color:#1e3a5f;">@news.Title</h5>
                            <p class="card-text text-muted small flex-grow-1" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                                @news.Summary
                            </p>
                            <div class="d-flex flex-wrap gap-1 my-2">
                                @if (!string.IsNullOrEmpty(news.State))
                                {
                                    <span class="badge rounded-pill" style="background:#ff9933; color:#fff;">
                                        <i class="fa-solid fa-map-marker-alt me-1"></i>@news.State
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(news.Language))
                                {
                                    <span class="badge rounded-pill bg-secondary">
                                        <i class="fa-solid fa-language me-1"></i>@news.Language
                                    </span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <small class="text-muted">
                                    <i class="fa-regular fa-calendar me-1"></i>@news.PublishedDate.ToString("dd MMM yyyy")
                                </small>
                                <a asp-action="Details" asp-controller="News" asp-route-id="@news.Id"
                                   class="btn btn-sm text-white" style="background:#1e3a5f;">
                                    <i class="fa-solid fa-comment-dots me-1"></i>Read &amp; Feedback
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Browse by Category -->
<section class="py-5" style="background:#f4f6fa;">
    <div class="container">
        <h2 class="fw-bold mb-4 text-center" style="color:#1e3a5f;">
            <i class="fa-solid fa-layer-group me-2" style="color:#ff9933;"></i>Browse by Category
        </h2>
        <div class="row g-4 justify-content-center">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-md-3 col-sm-6">
                    <a asp-action="Index" asp-controller="News" asp-route-categoryId="@cat.Id"
                       class="text-decoration-none">
                        <div class="card border-0 shadow-sm rounded-3 h-100 text-center p-3 category-card">
                            <div class="card-body">
                                <i class="fa-solid @(cat.IconClass ?? "fa-newspaper") fa-3x mb-3" style="color:#ff9933;"></i>
                                <h5 class="fw-bold" style="color:#1e3a5f;">@cat.Name</h5>
                                <p class="text-muted small mb-0">@cat.Description</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- News by Region (Nav Tabs) -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4" style="color:#1e3a5f;">
            <i class="fa-solid fa-map me-2" style="color:#ff9933;"></i>News by Region
        </h2>
        @{
            var topStates = Model.RegionalNews.Keys.Take(4).ToList();
        }
        <ul class="nav nav-tabs mb-4" id="regionTabs" role="tablist">
            @for (int i = 0; i < topStates.Count; i++)
            {
                var state = topStates[i];
                var safeId = System.Text.RegularExpressions.Regex.Replace(state, @"[^a-zA-Z0-9]", "");
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(i == 0 ? "active" : "")"
                            id="tab-@safeId"
                            data-bs-toggle="tab"
                            data-bs-target="#pane-@safeId"
                            type="button" role="tab">
                        <i class="fa-solid fa-map-marker-alt me-1" style="color:#ff9933;"></i>@state
                    </button>
                </li>
            }
        </ul>
        <div class="tab-content" id="regionTabsContent">
            @for (int i = 0; i < topStates.Count; i++)
            {
                var state = topStates[i];
                var safeId = System.Text.RegularExpressions.Regex.Replace(state, @"[^a-zA-Z0-9]", "");
                var stateNews = Model.RegionalNews[state].Take(3).ToList();
                <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="pane-@safeId" role="tabpanel">
                    <div class="row g-3">
                        @foreach (var news in stateNews)
                        {
                            <div class="col-md-4">
                                <div class="card border-0 shadow-sm rounded-3 h-100">
                                    <div class="card-body">
                                        @if (news.Category != null)
                                        {
                                            <span class="badge mb-2" style="background:#1e3a5f; color:white;">@news.Category.Name</span>
                                        }
                                        <h6 class="card-title fw-semibold" style="color:#1e3a5f;">@news.Title</h6>
                                        @{
                                            var summaryLen = news.Summary != null ? Math.Min(100, news.Summary.Length) : 0;
                                        }
                                        <p class="card-text text-muted small">
                                            @(summaryLen > 0 ? news.Summary!.Substring(0, summaryLen) + "..." : "")
                                        </p>
                                        <a asp-action="Details" asp-controller="News" asp-route-id="@news.Id"
                                           class="btn btn-sm text-white" style="background:#ff9933;">
                                            Read More
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="py-5" style="background:#1e3a5f;">
    <div class="container text-white">
        <h2 class="fw-bold mb-5 text-center">
            How It <span style="color:#ff9933;">Works</span>
        </h2>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:80px;height:80px;background:#ff9933;">
                        <i class="fa-solid fa-search fa-2x text-white"></i>
                    </div>
                    <h4 class="fw-bold">Step 1</h4>
                    <h5>Browse News</h5>
                    <p class="opacity-75">Search and filter government news stories by category, state, language, or keyword.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:80px;height:80px;background:#ff9933;">
                        <i class="fa-solid fa-newspaper fa-2x text-white"></i>
                    </div>
                    <h4 class="fw-bold">Step 2</h4>
                    <h5>Read Article</h5>
                    <p class="opacity-75">Read the full news story, understand its context, and see what other citizens think.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:80px;height:80px;background:#ff9933;">
                        <i class="fa-solid fa-star fa-2x text-white"></i>
                    </div>
                    <h4 class="fw-bold">Step 3</h4>
                    <h5>Submit Feedback</h5>
                    <p class="opacity-75">Rate the news story, share your sentiment, and add comments or suggestions for the government.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .category-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .category-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(30,58,95,0.15) !important;
    }
    .nav-tabs .nav-link.active {
        color: #1e3a5f;
        font-weight: 600;
        border-bottom: 3px solid #ff9933;
    }
    .nav-tabs .nav-link {
        color: #666;
    }
</style>
