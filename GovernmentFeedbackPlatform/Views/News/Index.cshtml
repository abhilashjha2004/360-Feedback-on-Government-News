@model GovernmentFeedbackPlatform.ViewModels.NewsListViewModel
@{
    ViewData["Title"] = "Government News";
    var indianStates = new[] { "Maharashtra", "Delhi", "Karnataka", "Tamil Nadu", "Uttar Pradesh", "Gujarat", "Rajasthan", "West Bengal", "Telangana", "Andhra Pradesh", "Kerala", "Madhya Pradesh", "Bihar", "Odisha", "Punjab", "Haryana", "Assam", "Jharkhand", "Chhattisgarh", "Uttarakhand", "Himachal Pradesh", "Goa", "Manipur", "Meghalaya", "Mizoram", "Nagaland", "Tripura", "Arunachal Pradesh", "Sikkim", "Jammu & Kashmir", "Ladakh" };
    var languages = new[] { "Hindi", "English", "Bengali", "Telugu", "Marathi", "Tamil", "Gujarati", "Kannada", "Malayalam", "Odia", "Punjabi", "Urdu", "Assamese", "Maithili", "Sanskrit" };
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;background:#1e3a5f;">
                    <i class="fas fa-newspaper text-white"></i>
                </div>
                <div>
                    <h2 class="mb-0 fw-bold" style="color:#1e3a5f;">Government News</h2>
                    <p class="text-muted mb-0 small">Stay informed. Share your feedback.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Filters -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm sticky-top" style="top:80px;">
                <div class="card-header border-0 text-white py-3" style="background:#1e3a5f;border-radius:12px 12px 0 0;">
                    <h6 class="mb-0 fw-semibold"><i class="fas fa-filter me-2"></i>Filter News</h6>
                </div>
                <div class="card-body p-3">
                    <form asp-action="Index" asp-controller="News" method="get">
                        <!-- Search -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:.5px;">Search</label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm" name="search" value="@Model.SearchTerm" placeholder="Search news..." />
                                <button class="btn btn-sm text-white" type="submit" style="background:#1e3a5f;">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Category Filter -->
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:.5px;">Category</label>
                                <div class="d-flex flex-column gap-1">
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="categoryId" value="@cat.Id"
                                                   id="cat_@cat.Id"
                                                   @(Model.CategoryId == cat.Id ? "checked" : "") />
                                            <label class="form-check-label small" for="cat_@cat.Id">
                                                @if (!string.IsNullOrEmpty(cat.IconClass))
                                                {
                                                    <i class="@cat.IconClass me-1" style="color:@(cat.ColorHex ?? "#1e3a5f");"></i>
                                                }
                                                @cat.Name
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- State Filter -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:.5px;">State / UT</label>
                            <select class="form-select form-select-sm" name="state">
                                <option value="">All States</option>
                                @foreach (var state in indianStates)
                                {
                                    <!option value="@state" @(Model.State == state ? "selected" : "")>@state</!option>
                                }
                            </select>
                        </div>

                        <!-- Language Filter -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted text-uppercase" style="letter-spacing:.5px;">Language</label>
                            <select class="form-select form-select-sm" name="language">
                                <option value="">All Languages</option>
                                @foreach (var lang in languages)
                                {
                                    <!option value="@lang" @(Model.Language == lang ? "selected" : "")>@lang</!option>
                                }
                            </select>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-sm text-white fw-semibold" style="background:#ff9933;">
                                <i class="fas fa-check me-1"></i>Apply Filters
                            </button>
                            <a asp-action="Index" asp-controller="News" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Clear Filters
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Results Count -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <p class="text-muted mb-0 small">
                    <i class="fas fa-info-circle me-1" style="color:#ff9933;"></i>
                    Showing <strong>@Model.NewsStories.Count</strong> of <strong>@Model.TotalCount</strong> news stories
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <span> for "<em>@Model.SearchTerm</em>"</span>
                    }
                </p>
                <span class="badge text-white" style="background:#1e3a5f;">Page @Model.CurrentPage of @Model.TotalPages</span>
            </div>

            @if (!Model.NewsStories.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-newspaper fa-4x mb-3 text-muted opacity-50"></i>
                    <h5 class="text-muted">No news stories found</h5>
                    <p class="text-muted small">Try adjusting your search filters.</p>
                    <a asp-action="Index" asp-controller="News" class="btn text-white" style="background:#1e3a5f;">
                        <i class="fas fa-sync me-2"></i>Reset Filters
                    </a>
                </div>
            }
            else
            {
                <!-- News Card Grid -->
                <div class="row g-3">
                    @foreach (var newsStory in Model.NewsStories)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm news-card" style="border-radius:12px;transition:transform .2s,box-shadow .2s;">
                                <!-- Card Image -->
                                <div class="position-relative overflow-hidden" style="border-radius:12px 12px 0 0;height:180px;">
                                    <img src="https://picsum.photos/seed/@newsStory.Id/600/300"
                                         class="card-img-top w-100 h-100"
                                         style="object-fit:cover;"
                                         alt="@newsStory.Title"
                                         loading="lazy" />
                                    @if (newsStory.Category != null)
                                    {
                                        <span class="badge position-absolute top-0 start-0 m-2 text-white"
                                              style="background:@(newsStory.Category.ColorHex ?? "#1e3a5f");font-size:.7rem;">
                                            @if (!string.IsNullOrEmpty(newsStory.Category.IconClass))
                                            {
                                                <i class="@newsStory.Category.IconClass me-1"></i>
                                            }
                                            @newsStory.Category.Name
                                        </span>
                                    }
                                </div>

                                <div class="card-body d-flex flex-column p-3">
                                    <!-- Title -->
                                    <h6 class="card-title fw-bold mb-2" style="color:#1e3a5f;line-height:1.4;">
                                        @(newsStory.Title.Length > 70 ? newsStory.Title.Substring(0, 70) + "…" : newsStory.Title)
                                    </h6>

                                    <!-- Summary -->
                                    <p class="card-text text-muted small mb-3 flex-grow-1">
                                        @if (!string.IsNullOrEmpty(newsStory.Summary))
                                        {
                                            @(newsStory.Summary.Length > 120 ? newsStory.Summary.Substring(0, 120) + "…" : newsStory.Summary)
                                        }
                                    </p>

                                    <!-- State / Language Chips -->
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @if (!string.IsNullOrEmpty(newsStory.State))
                                        {
                                            <span class="badge rounded-pill border small" style="color:#1e3a5f;border-color:#1e3a5f!important;background:transparent;font-size:.65rem;">
                                                <i class="fas fa-map-marker-alt me-1"></i>@newsStory.State
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(newsStory.Language))
                                        {
                                            <span class="badge rounded-pill border small" style="color:#ff9933;border-color:#ff9933!important;background:transparent;font-size:.65rem;">
                                                <i class="fas fa-language me-1"></i>@newsStory.Language
                                            </span>
                                        }
                                    </div>

                                    <!-- Date & CTA -->
                                    <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar-alt me-1"></i>
                                            @newsStory.PublishedDate.ToString("dd MMM yyyy")
                                        </small>
                                        <a asp-action="Details" asp-controller="News" asp-route-id="@newsStory.Id"
                                           class="btn btn-sm text-white fw-semibold"
                                           style="background:#ff9933;font-size:.75rem;">
                                            <i class="fas fa-comment-dots me-1"></i>Read &amp; Feedback
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-4" aria-label="News pagination">
                        <ul class="pagination justify-content-center">
                            <!-- Previous -->
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-controller="News"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-search="@Model.SearchTerm"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-state="@Model.State"
                                   asp-route-language="@Model.Language"
                                   style="color:#1e3a5f;">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>

                            @{
                                int startPage = Math.Max(1, Model.CurrentPage - 2);
                                int endPage = Math.Min(Model.TotalPages, startPage + 4);
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-controller="News" asp-route-page="1"
                                       asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId"
                                       asp-route-state="@Model.State" asp-route-language="@Model.Language"
                                       style="color:#1e3a5f;">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                }
                            }

                            @for (int p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-controller="News" asp-route-page="@p"
                                       asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId"
                                       asp-route-state="@Model.State" asp-route-language="@Model.Language"
                                       style="@(p == Model.CurrentPage ? "background:#1e3a5f;border-color:#1e3a5f;" : "color:#1e3a5f;")">@p</a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-controller="News" asp-route-page="@Model.TotalPages"
                                       asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId"
                                       asp-route-state="@Model.State" asp-route-language="@Model.Language"
                                       style="color:#1e3a5f;">@Model.TotalPages</a>
                                </li>
                            }

                            <!-- Next -->
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-controller="News"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-search="@Model.SearchTerm"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-state="@Model.State"
                                   asp-route-language="@Model.Language"
                                   style="color:#1e3a5f;">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

<style>
    .news-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(30,58,95,.15) !important;
    }
    .form-check-input:checked {
        background-color: #1e3a5f;
        border-color: #1e3a5f;
    }
    .page-item.active .page-link {
        color: #fff !important;
    }
</style>
