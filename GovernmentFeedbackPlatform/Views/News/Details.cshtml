@model GovernmentFeedbackPlatform.ViewModels.NewsDetailViewModel

@{
    ViewData["Title"] = Model.NewsStory?.Title ?? "News Details";
}

<div class="container py-4">
    <!-- Breadcrumb & Back -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="News" asp-action="Index" class="text-decoration-none">News Stories</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width:300px;" aria-current="page">@Model.NewsStory?.Title</li>
        </ol>
    </nav>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Main Story Content (Col-8) -->
        <div class="col-lg-8">
            <article class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                @if (!string.IsNullOrEmpty(Model.NewsStory?.ImageUrl))
                {
                    <img src="@Model.NewsStory.ImageUrl" class="card-img-top" alt="@Model.NewsStory.Title" style="max-height: 400px; object-fit: cover;" />
                }

                <div class="card-body p-4 p-md-5">
                    <!-- Badges -->
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        @if (Model.NewsStory?.Category != null)
                        {
                            <span class="badge" style="background:@(Model.NewsStory.Category.ColorHex ?? "#1e3a5f"); font-size: 0.8rem;">
                                @if (!string.IsNullOrEmpty(Model.NewsStory.Category.IconClass))
                                {
                                    <i class="@Model.NewsStory.Category.IconClass me-1"></i>
                                }
                                @Model.NewsStory.Category.Name
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.NewsStory?.State))
                        {
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-map-pin me-1 text-danger"></i>@Model.NewsStory.State
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.NewsStory?.Language))
                        {
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-language me-1 text-primary"></i>@Model.NewsStory.Language
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.NewsStory?.MediaSource))
                        {
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-newspaper me-1 text-secondary"></i>@Model.NewsStory.MediaSource
                            </span>
                        }
                    </div>

                    <!-- Title -->
                    <h2 class="fw-bold mb-3" style="color:#1e3a5f; line-height: 1.3;">
                        @Model.NewsStory?.Title
                    </h2>

                    <!-- Publish info -->
                    <div class="text-muted small pb-3 mb-4 border-bottom d-flex align-items-center gap-3">
                        <span><i class="fa-solid fa-calendar me-1"></i>Published: @Model.NewsStory?.PublishedDate.ToString("dd MMMM yyyy")</span>
                        @if (!string.IsNullOrEmpty(Model.NewsStory?.SourceUrl))
                        {
                            <a href="@Model.NewsStory.SourceUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Original Source
                            </a>
                        }
                    </div>

                    <!-- Summary Callout -->
                    @if (!string.IsNullOrEmpty(Model.NewsStory?.Summary))
                    {
                        <div class="p-3 rounded-3 mb-4" style="background:#f1f5f9; border-left: 4px solid #ff9933;">
                            <p class="mb-0 fw-medium text-dark" style="font-size: 1.05rem;">
                                @Model.NewsStory.Summary
                            </p>
                        </div>
                    }

                    <!-- Full Content -->
                    <div class="article-content leading-relaxed text-secondary mb-4" style="font-size: 1.05rem; line-height: 1.8;">
                        <p>@Model.NewsStory?.Content</p>
                    </div>

                    <!-- Tags -->
                    @if (!string.IsNullOrEmpty(Model.NewsStory?.Tags))
                    {
                        <div class="pt-3 border-top d-flex flex-wrap gap-2 align-items-center">
                            <span class="small text-muted fw-semibold"><i class="fa-solid fa-tags me-1"></i>Tags:</span>
                            @foreach (var tag in Model.NewsStory.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis small">#@tag.Trim()</span>
                            }
                        </div>
                    }
                </div>
            </article>

            <!-- 360-Degree Feedback Form / Status Area -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" id="feedback-section">
                <div class="card-header text-white py-3 px-4 d-flex align-items-center justify-content-between"
                     style="background: #1e3a5f; border-bottom: 3px solid #ff9933;">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-comments me-2 text-warning"></i>360° Citizen Feedback
                    </h5>
                    <span class="small badge bg-warning text-dark">Citizen Response</span>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <div class="text-center py-4">
                            <i class="fa-solid fa-user-lock fa-3x text-muted mb-3"></i>
                            <h5 class="fw-bold" style="color:#1e3a5f;">Sign in to Share Your Feedback</h5>
                            <p class="text-muted small max-w-500 mx-auto mb-4">
                                Your voice matters. Register or login to submit your rating, sentiment, and constructive recommendations on this government news story.
                            </p>
                            <div class="d-flex justify-content-center gap-3">
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary px-4" style="background:#1e3a5f;">
                                    <i class="fa-solid fa-right-to-bracket me-1"></i>Login
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-warning px-4 text-dark fw-semibold" style="background:#ff9933;">
                                    <i class="fa-solid fa-user-plus me-1"></i>Register
                                </a>
                            </div>
                        </div>
                    }
                    else if (Model.UserAlreadySubmitted && Model.UserFeedback != null)
                    {
                        <!-- Already Submitted Alert -->
                        <div class="alert alert-success border-0 rounded-3 p-4 mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h6 class="fw-bold text-success mb-0">
                                    <i class="fa-solid fa-circle-check me-2"></i>You have provided 360° feedback for this story
                                </h6>
                                <span class="small text-muted">Submitted on @Model.UserFeedback.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="mb-2">
                                <strong>Your Rating:</strong>
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <i class="fa-solid fa-star @(s <= Model.UserFeedback.Rating ? "text-warning" : "text-muted")"></i>
                                }
                                <span class="ms-2 badge @(Model.UserFeedback.UserSentiment.ToString() == "Positive" ? "bg-success" : Model.UserFeedback.UserSentiment.ToString() == "Negative" ? "bg-danger" : "bg-warning text-dark")">
                                    @Model.UserFeedback.UserSentiment
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.UserFeedback.Comment))
                            {
                                <p class="mb-1 text-dark small"><strong>Comment:</strong> "@Model.UserFeedback.Comment"</p>
                            }
                            @if (!string.IsNullOrEmpty(Model.UserFeedback.Suggestions))
                            {
                                <p class="mb-0 text-muted small"><strong>Suggestions:</strong> "@Model.UserFeedback.Suggestions"</p>
                            }

                            <div class="d-flex gap-2 mt-3 pt-3 border-top">
                                <a asp-controller="Citizen" asp-action="EditFeedback" asp-route-id="@Model.UserFeedback.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>Edit Feedback
                                </a>
                                <form asp-controller="Feedback" asp-action="Delete" asp-route-id="@Model.UserFeedback.Id" method="post" onsubmit="return confirm('Are you sure you want to delete your feedback?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Submission Form -->
                        <form asp-controller="Feedback" asp-action="Submit" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="newsStoryId" value="@Model.NewsStory?.Id" />

                            <!-- 1. Star Rating -->
                            <div class="mb-4">
                                <label class="form-label fw-bold small text-uppercase" style="color:#1e3a5f;">1. Overall Rating (1 to 5 Stars) *</label>
                                <div class="d-flex gap-3 align-items-center">
                                    <div class="rating-stars" id="star-picker">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <input type="radio" id="star-@i" name="rating" value="@i" @(i == 4 ? "checked" : "") class="btn-check" />
                                            <label for="star-@i" class="btn btn-outline-warning text-dark px-3 py-2">
                                                <i class="fa-solid fa-star text-warning"></i> @i
                                            </label>
                                        }
                                    </div>
                                    <span class="small text-muted">Select rating based on policy impact</span>
                                </div>
                            </div>

                            <!-- 2. Sentiment -->
                            <div class="mb-4">
                                <label class="form-label fw-bold small text-uppercase" style="color:#1e3a5f;">2. Citizen Sentiment / Opinion *</label>
                                <div class="d-flex flex-wrap gap-2">
                                    <input type="radio" class="btn-check" name="userSentiment" id="sent-pos" value="Positive" />
                                    <label class="btn btn-outline-success px-3 py-2" for="sent-pos">
                                        <i class="fa-solid fa-thumbs-up me-1"></i> Positive
                                    </label>

                                    <input type="radio" class="btn-check" name="userSentiment" id="sent-neu" value="Neutral" checked />
                                    <label class="btn btn-outline-warning text-dark px-3 py-2" for="sent-neu">
                                        <i class="fa-solid fa-minus me-1"></i> Neutral
                                    </label>

                                    <input type="radio" class="btn-check" name="userSentiment" id="sent-neg" value="Negative" />
                                    <label class="btn btn-outline-danger px-3 py-2" for="sent-neg">
                                        <i class="fa-solid fa-thumbs-down me-1"></i> Negative
                                    </label>
                                </div>
                            </div>

                            <!-- 3. Feedback Category -->
                            <div class="mb-4">
                                <label class="form-label fw-bold small text-uppercase" style="color:#1e3a5f;">3. Focus Dimension</label>
                                <select name="feedbackCategory" class="form-select">
                                    <option value="Policy Impact">Policy Impact &amp; Public Good</option>
                                    <option value="Implementation">Ground Implementation &amp; Delivery</option>
                                    <option value="Regional Relevance">Regional &amp; Local Relevance</option>
                                    <option value="Transparency">Transparency &amp; Governance</option>
                                    <option value="General Opinion">General Opinion</option>
                                </select>
                            </div>

                            <!-- 4. Comments -->
                            <div class="mb-4">
                                <label class="form-label fw-bold small text-uppercase" style="color:#1e3a5f;">4. Detailed Feedback / Comment</label>
                                <textarea name="comment" class="form-control" rows="3" placeholder="Share your perspective on this news story, its regional reception, and its practical effects..."></textarea>
                            </div>

                            <!-- 5. Constructive Suggestions -->
                            <div class="mb-4">
                                <label class="form-label fw-bold small text-uppercase" style="color:#1e3a5f;">5. Suggestions for Government Communication / Policy Enhancement</label>
                                <textarea name="suggestions" class="form-control" rows="2" placeholder="What improvements or communication strategies would enhance this initiative in your state?"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary fw-semibold px-4 py-2" style="background:#1e3a5f; border-color:#1e3a5f;">
                                <i class="fa-solid fa-paper-plane me-2"></i>Submit 360° Feedback
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- Recent Citizen Feedbacks List -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold mb-0" style="color:#1e3a5f;">
                        <i class="fa-solid fa-user-group me-2 text-warning"></i>Recent Public Reviews (@Model.RecentFeedbacks.Count)
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!Model.RecentFeedbacks.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">No feedbacks have been submitted yet. Be the first citizen to review this news story!</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var fb in Model.RecentFeedbacks)
                            {
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold small" style="color:#1e3a5f;">@(fb.User?.FullName ?? "Citizen Reviewer")</span>
                                            @if (!string.IsNullOrEmpty(fb.User?.State))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis small">@fb.User.State</span>
                                            }
                                        </div>
                                        <span class="text-muted small">@fb.CreatedAt.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <div class="mb-2">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <i class="fa-solid fa-star @(s <= fb.Rating ? "text-warning" : "text-muted")" style="font-size:0.8rem;"></i>
                                        }
                                        <span class="badge @(fb.UserSentiment.ToString() == "Positive" ? "bg-success" : fb.UserSentiment.ToString() == "Negative" ? "bg-danger" : "bg-warning text-dark") ms-2 small">
                                            @fb.UserSentiment
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(fb.Comment))
                                    {
                                        <p class="mb-1 text-secondary small">@fb.Comment</p>
                                    }
                                    @if (!string.IsNullOrEmpty(fb.Suggestions))
                                    {
                                        <p class="mb-0 text-muted small fst-italic"><i class="fa-solid fa-lightbulb text-warning me-1"></i>Suggestion: @fb.Suggestions</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Analytics & Breakdown (Col-4) -->
        <div class="col-lg-4">
            <!-- Summary Stats Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background:#f8fafc; border-top: 4px solid #1e3a5f !important;">
                <h5 class="fw-bold mb-3" style="color:#1e3a5f;">
                    <i class="fa-solid fa-chart-pie me-2 text-warning"></i>Story Feedback Score
                </h5>

                <div class="text-center py-3 mb-3 bg-white rounded-3 shadow-sm">
                    <h1 class="display-4 fw-bold mb-0 text-warning">@Model.Stats?.AverageRating.ToString("F1")</h1>
                    <div class="mb-1">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <i class="fa-solid fa-star @(s <= Math.Round(Model.Stats?.AverageRating ?? 0) ? "text-warning" : "text-muted")"></i>
                        }
                    </div>
                    <small class="text-muted">Based on @(Model.Stats?.TotalFeedbacks ?? 0) citizen submissions</small>
                </div>

                <!-- Sentiment Meter -->
                <h6 class="small fw-bold text-uppercase text-muted mb-2">Public Sentiment Distribution</h6>
                <div class="progress mb-3" style="height: 12px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @(Model.Stats?.PositivePercentage ?? 0)%;" title="Positive @(Model.Stats?.PositivePercentage)%"></div>
                    <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.Stats?.NeutralPercentage ?? 0)%;" title="Neutral @(Model.Stats?.NeutralPercentage)%"></div>
                    <div class="progress-bar bg-danger" role="progressbar" style="width: @(Model.Stats?.NegativePercentage ?? 0)%;" title="Negative @(Model.Stats?.NegativePercentage)%"></div>
                </div>

                <div class="d-flex justify-content-between small text-muted mb-4">
                    <span><i class="fa-solid fa-circle text-success me-1"></i>Pos: @(Model.Stats?.PositivePercentage ?? 0)%</span>
                    <span><i class="fa-solid fa-circle text-warning me-1"></i>Neu: @(Model.Stats?.NeutralPercentage ?? 0)%</span>
                    <span><i class="fa-solid fa-circle text-danger me-1"></i>Neg: @(Model.Stats?.NegativePercentage ?? 0)%</span>
                </div>

                <!-- Star breakdown -->
                <h6 class="small fw-bold text-uppercase text-muted mb-2">Rating Breakdown</h6>
                <div class="d-flex flex-column gap-1">
                    @for (int star = 5; star >= 1; star--)
                    {
                        var count = Model.Stats?.RatingDistribution?.GetValueOrDefault(star, 0) ?? 0;
                        var pct = (Model.Stats?.TotalFeedbacks ?? 0) > 0 ? (count * 100.0 / Model.Stats!.TotalFeedbacks) : 0;
                        <div class="d-flex align-items-center gap-2 small">
                            <span class="text-muted" style="width:50px;">@star Star</span>
                            <div class="progress flex-grow-1" style="height: 6px;">
                                <div class="progress-bar bg-warning" style="width: @pct%;"></div>
                            </div>
                            <span class="text-muted text-end" style="width:30px;">@count</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Share & Media Source Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                <i class="fa-solid fa-newspaper fa-2x text-primary mb-2"></i>
                <h6 class="fw-bold text-navy mb-1">Regional Media Sourcing</h6>
                <p class="small text-muted mb-3">Published via regional press coverage across @(Model.NewsStory?.State ?? "India"). Feedback is analyzed for policy communication enhancement.</p>
                <a href="#feedback-section" class="btn btn-outline-warning text-dark btn-sm fw-semibold">
                    <i class="fa-solid fa-comment-dots me-1"></i>Rate this News Story
                </a>
            </div>
        </div>
    </div>
</div>
