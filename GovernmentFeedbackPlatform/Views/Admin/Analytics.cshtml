@model GovernmentFeedbackPlatform.ViewModels.AnalyticsViewModel

@{
    ViewData["Title"] = "Analytics Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color:#1e3a5f;"><i class="fas fa-chart-line me-2" style="color:#ff9933;"></i>Analytics Dashboard</h2>
    <span class="text-muted small">Last updated: @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
</div>

<!-- Filter Bar -->
<div class="card shadow-sm mb-4" style="border-top: 3px solid #ff9933;">
    <div class="card-body">
        <form method="get" action="">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small" style="color:#1e3a5f;">Date From</label>
                    <input type="date" name="dateFrom" class="form-control" value="@ViewBag.DateFrom" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small" style="color:#1e3a5f;">Date To</label>
                    <input type="date" name="dateTo" class="form-control" value="@ViewBag.DateTo" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small" style="color:#1e3a5f;">State</label>
                    <select name="state" class="form-select">
                        <option value="">All States</option>
                        <!option value="Maharashtra" @(Model.FilterState == "Maharashtra" ? "selected" : "")>Maharashtra</!option>
                        <!option value="Delhi" @(Model.FilterState == "Delhi" ? "selected" : "")>Delhi</!option>
                        <!option value="Karnataka" @(Model.FilterState == "Karnataka" ? "selected" : "")>Karnataka</!option>
                        <!option value="Tamil Nadu" @(Model.FilterState == "Tamil Nadu" ? "selected" : "")>Tamil Nadu</!option>
                        <!option value="Uttar Pradesh" @(Model.FilterState == "Uttar Pradesh" ? "selected" : "")>Uttar Pradesh</!option>
                        <!option value="Gujarat" @(Model.FilterState == "Gujarat" ? "selected" : "")>Gujarat</!option>
                        <!option value="Rajasthan" @(Model.FilterState == "Rajasthan" ? "selected" : "")>Rajasthan</!option>
                        <!option value="West Bengal" @(Model.FilterState == "West Bengal" ? "selected" : "")>West Bengal</!option>
                        <!option value="Telangana" @(Model.FilterState == "Telangana" ? "selected" : "")>Telangana</!option>
                        <!option value="Andhra Pradesh" @(Model.FilterState == "Andhra Pradesh" ? "selected" : "")>Andhra Pradesh</!option>
                        <!option value="Kerala" @(Model.FilterState == "Kerala" ? "selected" : "")>Kerala</!option>
                        <!option value="Madhya Pradesh" @(Model.FilterState == "Madhya Pradesh" ? "selected" : "")>Madhya Pradesh</!option>
                        <!option value="Bihar" @(Model.FilterState == "Bihar" ? "selected" : "")>Bihar</!option>
                        <!option value="Odisha" @(Model.FilterState == "Odisha" ? "selected" : "")>Odisha</!option>
                        <!option value="Punjab" @(Model.FilterState == "Punjab" ? "selected" : "")>Punjab</!option>
                        <!option value="Haryana" @(Model.FilterState == "Haryana" ? "selected" : "")>Haryana</!option>
                        <!option value="Assam" @(Model.FilterState == "Assam" ? "selected" : "")>Assam</!option>
                        <!option value="Jharkhand" @(Model.FilterState == "Jharkhand" ? "selected" : "")>Jharkhand</!option>
                        <!option value="Chhattisgarh" @(Model.FilterState == "Chhattisgarh" ? "selected" : "")>Chhattisgarh</!option>
                        <!option value="Uttarakhand" @(Model.FilterState == "Uttarakhand" ? "selected" : "")>Uttarakhand</!option>
                        <!option value="Himachal Pradesh" @(Model.FilterState == "Himachal Pradesh" ? "selected" : "")>Himachal Pradesh</!option>
                        <!option value="Goa" @(Model.FilterState == "Goa" ? "selected" : "")>Goa</!option>
                        <!option value="Manipur" @(Model.FilterState == "Manipur" ? "selected" : "")>Manipur</!option>
                        <!option value="Meghalaya" @(Model.FilterState == "Meghalaya" ? "selected" : "")>Meghalaya</!option>
                        <!option value="Mizoram" @(Model.FilterState == "Mizoram" ? "selected" : "")>Mizoram</!option>
                        <!option value="Nagaland" @(Model.FilterState == "Nagaland" ? "selected" : "")>Nagaland</!option>
                        <!option value="Tripura" @(Model.FilterState == "Tripura" ? "selected" : "")>Tripura</!option>
                        <!option value="Arunachal Pradesh" @(Model.FilterState == "Arunachal Pradesh" ? "selected" : "")>Arunachal Pradesh</!option>
                        <!option value="Sikkim" @(Model.FilterState == "Sikkim" ? "selected" : "")>Sikkim</!option>
                        <!option value="Jammu & Kashmir" @(Model.FilterState == "Jammu & Kashmir" ? "selected" : "")>Jammu &amp; Kashmir</!option>
                        <!option value="Ladakh" @(Model.FilterState == "Ladakh" ? "selected" : "")>Ladakh</!option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small" style="color:#1e3a5f;">Category</label>
                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <!option value="@cat.Id" @(Model.FilterCategoryId == cat.Id ? "selected" : "")>@cat.Name</!option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm flex-fill" style="background:#ff9933; color:#fff; font-weight:600;">
                        <i class="fas fa-filter me-1"></i>Apply
                    </button>
                    <a href="@Url.Action("Analytics", "Admin")" class="btn btn-sm btn-outline-secondary flex-fill">
                        <i class="fas fa-times me-1"></i>Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm h-100 text-center" style="border-top: 4px solid #1e3a5f;">
            <div class="card-body py-4">
                <div class="mb-2">
                    <i class="fas fa-comments fa-2x" style="color:#ff9933;"></i>
                </div>
                <h2 class="fw-bold mb-0" style="color:#1e3a5f;">@Model.OverallStats.TotalFeedbacks</h2>
                <p class="text-muted small mb-0">Total Feedbacks</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 text-center" style="border-top: 4px solid #ff9933;">
            <div class="card-body py-4">
                <div class="mb-2">
                    <i class="fas fa-star fa-2x" style="color:#ff9933;"></i>
                </div>
                <h2 class="fw-bold mb-0" style="color:#1e3a5f;">@Model.OverallStats.AverageRating.ToString("F1")</h2>
                <p class="text-muted small mb-0">Average Rating</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 text-center" style="border-top: 4px solid #28a745;">
            <div class="card-body py-4">
                <div class="mb-2">
                    <i class="fas fa-thumbs-up fa-2x text-success"></i>
                </div>
                <h2 class="fw-bold mb-0 text-success">
                    @(Model.OverallStats.TotalFeedbacks > 0
                        ? ((Model.TotalPositive * 100.0 / Model.OverallStats.TotalFeedbacks).ToString("F1") + "%")
                        : "0%")
                </h2>
                <p class="text-muted small mb-0">Positive Sentiment</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 text-center" style="border-top: 4px solid #17a2b8;">
            <div class="card-body py-4">
                <div class="mb-2">
                    <i class="fas fa-newspaper fa-2x text-info"></i>
                </div>
                <h2 class="fw-bold mb-0 text-info">@Model.OverallStats.TotalNewsStories</h2>
                <p class="text-muted small mb-0">Total News Stories</p>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 1: Sentiment & Regional -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold" style="background:#1e3a5f; color:#fff;">
                <i class="fas fa-smile me-2" style="color:#ff9933;"></i>Sentiment Distribution
            </div>
            <div class="card-body d-flex align-items-center justify-content-center" style="min-height:300px;">
                <canvas id="sentimentChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold" style="background:#1e3a5f; color:#fff;">
                <i class="fas fa-map-marker-alt me-2" style="color:#ff9933;"></i>Feedback by Region
            </div>
            <div class="card-body" style="min-height:300px;">
                <canvas id="regionalChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 2: Monthly Trend & Category -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold" style="background:#1e3a5f; color:#fff;">
                <i class="fas fa-chart-line me-2" style="color:#ff9933;"></i>Monthly Feedback Trend
            </div>
            <div class="card-body" style="min-height:300px;">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold" style="background:#1e3a5f; color:#fff;">
                <i class="fas fa-tags me-2" style="color:#ff9933;"></i>Feedback by Category
            </div>
            <div class="card-body" style="min-height:300px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 3: Rating Distribution & News vs Feedback -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold" style="background:#1e3a5f; color:#fff;">
                <i class="fas fa-star me-2" style="color:#ff9933;"></i>Rating Distribution
            </div>
            <div class="card-body" style="min-height:300px;">
                <canvas id="ratingChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold" style="background:#1e3a5f; color:#fff;">
                <i class="fas fa-chart-area me-2" style="color:#ff9933;"></i>News Published vs Feedback Received
            </div>
            <div class="card-body" style="min-height:300px;">
                <canvas id="newsVsFeedbackChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Data from server
        const sentimentData = {
            positive: @Model.TotalPositive,
            neutral: @Model.TotalNeutral,
            negative: @Model.TotalNegative
        };

        const regionalLabels = @Html.Raw(Json.Serialize(Model.RegionalStats.Select(r => r.State).ToList()));
        const regionalData   = @Html.Raw(Json.Serialize(Model.RegionalStats.Select(r => r.FeedbackCount).ToList()));

        const trendLabels       = @Html.Raw(Json.Serialize(Model.MonthlyTrends.Select(t => t.Month).ToList()));
        const trendFeedbacks    = @Html.Raw(Json.Serialize(Model.MonthlyTrends.Select(t => t.FeedbackCount).ToList()));
        const trendNews         = @Html.Raw(Json.Serialize(Model.MonthlyTrends.Select(t => t.NewsCount).ToList()));

        const categoryLabels = @Html.Raw(Json.Serialize(Model.CategoryStats.Select(c => c.CategoryName).ToList()));
        const categoryData   = @Html.Raw(Json.Serialize(Model.CategoryStats.Select(c => c.FeedbackCount).ToList()));

        const navy   = '#1e3a5f';
        const saffron = '#ff9933';

        // 1. Sentiment Doughnut
        new Chart(document.getElementById('sentimentChart'), {
            type: 'doughnut',
            data: {
                labels: ['Positive', 'Neutral', 'Negative'],
                datasets: [{
                    data: [sentimentData.positive, sentimentData.neutral, sentimentData.negative],
                    backgroundColor: ['#28a745', '#ffc107', '#dc3545'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // 2. Regional Bar
        new Chart(document.getElementById('regionalChart'), {
            type: 'bar',
            data: {
                labels: regionalLabels,
                datasets: [{
                    label: 'Feedbacks',
                    data: regionalData,
                    backgroundColor: saffron,
                    borderColor: navy,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // 3. Monthly Trend Line
        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Feedbacks',
                    data: trendFeedbacks,
                    borderColor: navy,
                    backgroundColor: 'rgba(30,58,95,0.1)',
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: saffron,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // 4. Category Bar
        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: categoryLabels,
                datasets: [{
                    label: 'Feedbacks',
                    data: categoryData,
                    backgroundColor: navy,
                    borderColor: saffron,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // 5. Rating Distribution Bar (real database data)
        new Chart(document.getElementById('ratingChart'), {
            type: 'bar',
            data: {
                labels: ['1 Star', '2 Stars', '3 Stars', '4 Stars', '5 Stars'],
                datasets: [{
                    label: 'Count',
                    data: [@Model.RatingDistribution.GetValueOrDefault(1, 0), @Model.RatingDistribution.GetValueOrDefault(2, 0), @Model.RatingDistribution.GetValueOrDefault(3, 0), @Model.RatingDistribution.GetValueOrDefault(4, 0), @Model.RatingDistribution.GetValueOrDefault(5, 0)],
                    backgroundColor: ['#dc3545', '#fd7e14', '#ffc107', '#20c997', '#28a745'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 5 } } }
            }
        });

        // 6. News vs Feedback Line
        new Chart(document.getElementById('newsVsFeedbackChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [
                    {
                        label: 'News Published',
                        data: trendNews,
                        borderColor: navy,
                        backgroundColor: 'rgba(30,58,95,0.08)',
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: navy,
                        pointRadius: 4
                    },
                    {
                        label: 'Feedbacks Received',
                        data: trendFeedbacks,
                        borderColor: saffron,
                        backgroundColor: 'rgba(255,153,51,0.08)',
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: saffron,
                        pointRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}
