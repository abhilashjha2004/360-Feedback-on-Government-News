@model List<GovernmentFeedbackPlatform.Models.ApplicationUser>

@{
    ViewData["Title"] = "Platform Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color:#1e3a5f;">
            <i class="fa-solid fa-users me-2 text-warning"></i>Registered Users Directory
        </h3>
        <p class="text-muted small mb-0">Citizen and administrator demographic overview across Indian states and languages.</p>
    </div>
    <span class="badge bg-primary px-3 py-2 fs-6">@Model.Count Total Registered</span>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background:#f8fafc; border-bottom: 2px solid #e2e8f0;">
                <tr>
                    <th class="ps-4" style="color:#1e3a5f;">Citizen Name</th>
                    <th style="color:#1e3a5f;">Email Address</th>
                    <th style="color:#1e3a5f;">State / UT</th>
                    <th style="color:#1e3a5f;">Language</th>
                    <th style="color:#1e3a5f;">Age &amp; Occupation</th>
                    <th style="color:#1e3a5f;">Member Since</th>
                    <th style="color:#1e3a5f;">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold small"
                                     style="width: 32px; height: 32px; background: #1e3a5f;">
                                    @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName[0].ToString().ToUpper())
                                </div>
                                <span class="fw-semibold text-navy">@user.FullName</span>
                            </div>
                        </td>
                        <td class="small text-muted">@user.Email</td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-map-pin me-1 text-danger"></i>@(user.State ?? "National")
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-language me-1 text-primary"></i>@(user.Language ?? "English")
                            </span>
                        </td>
                        <td class="small text-muted">
                            @(user.AgeGroup ?? "—") &bull; @(user.Occupation ?? "Citizen")
                        </td>
                        <td class="small text-muted">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Disabled</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
