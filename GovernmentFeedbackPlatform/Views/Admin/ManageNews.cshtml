@model List<GovernmentFeedbackPlatform.Models.NewsStory>

@{
    ViewData["Title"] = "Manage News Stories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool? published = ViewBag.Published;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color:#1e3a5f;">
            <i class="fa-solid fa-newspaper me-2 text-warning"></i>Manage News Stories
        </h3>
        <p class="text-muted small mb-0">Publish, unpublish, edit and monitor regional news coverage across India.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CreateNews" class="btn btn-warning fw-semibold text-dark btn-sm" style="background:#ff9933;">
            <i class="fa-solid fa-plus me-1"></i>Create News Story
        </a>
    </div>
</div>

<!-- Filter Tabs -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="btn-group btn-group-sm" role="group">
                <a asp-action="ManageNews" asp-route-published="" class="btn @(published == null ? "btn-primary" : "btn-outline-primary")">All Stories</a>
                <a asp-action="ManageNews" asp-route-published="true" class="btn @(published == true ? "btn-success" : "btn-outline-success")">Published Only</a>
                <a asp-action="ManageNews" asp-route-published="false" class="btn @(published == false ? "btn-warning" : "btn-outline-warning")">Drafts / Unpublished</a>
            </div>
            <span class="text-muted small">Showing @Model.Count stories on page @currentPage of @totalPages</span>
        </div>
    </div>
</div>

<!-- News Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead style="background:#f8fafc; border-bottom: 2px solid #e2e8f0;">
                <tr>
                    <th class="ps-4" style="color:#1e3a5f;">ID</th>
                    <th style="color:#1e3a5f;">Story Title &amp; Source</th>
                    <th style="color:#1e3a5f;">Category</th>
                    <th style="color:#1e3a5f;">State / Region</th>
                    <th style="color:#1e3a5f;">Status</th>
                    <th style="color:#1e3a5f;">Published Date</th>
                    <th class="text-end pe-4" style="color:#1e3a5f;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No news stories found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var story in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@story.Id</td>
                            <td>
                                <div class="fw-semibold text-navy text-truncate" style="max-width:320px;">
                                    <a asp-controller="News" asp-action="Details" asp-route-id="@story.Id" target="_blank" class="text-decoration-none" style="color:#1e3a5f;">
                                        @story.Title
                                    </a>
                                </div>
                                <small class="text-muted">
                                    <i class="fa-solid fa-newspaper me-1"></i>@(story.MediaSource ?? "Regional Media") &bull; @(story.Language ?? "English")
                                </small>
                            </td>
                            <td>
                                <span class="badge" style="background:@(story.Category?.ColorHex ?? "#1e3a5f");">
                                    @(story.Category?.Name ?? "General")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-map-pin me-1 text-danger"></i>@(story.State ?? "National")
                                </span>
                            </td>
                            <td>
                                @if (story.IsPublished)
                                {
                                    <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-pen-ruler me-1"></i>Draft</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @story.PublishedDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <!-- Toggle Publish -->
                                    <form asp-action="TogglePublish" asp-route-id="@story.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(story.IsPublished ? "btn-outline-secondary" : "btn-outline-success")"
                                                title="@(story.IsPublished ? "Unpublish story" : "Publish story")">
                                            <i class="fa-solid @(story.IsPublished ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </form>

                                    <!-- Edit -->
                                    <a asp-action="EditNews" asp-route-id="@story.Id" class="btn btn-sm btn-outline-primary" title="Edit story">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <!-- Delete -->
                                    <form asp-action="DeleteNews" asp-route-id="@story.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to permanently delete this news story?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete story">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav class="d-flex justify-content-center">
        <ul class="pagination pagination-sm">
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="ManageNews" asp-route-page="@p" asp-route-published="@published">@p</a>
                </li>
            }
        </ul>
    </nav>
}
